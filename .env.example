# Project Environment
PROJECT_NAME="Enterprise AI Knowledge Platform"
ENVIRONMENT="development"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Security & JWT
# Production: bắt buộc chuỗi ngẫu nhiên >= 32 ký tự, không chứa "change_me"/"your_".
SECRET_KEY="change_this_to_a_super_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: danh sách origin tường minh, phân tách bằng dấu phẩy. Production cấm "*".
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:3000"

# Upload guard: chặn file vượt 25MB trước khi parse (Zero Raw Storage).
MAX_UPLOAD_SIZE_BYTES=26214400

# Row-Level Security (PostgreSQL 16).
# Production bắt buộc True và role kết nối phải KHÔNG phải superuser / BYPASSRLS.
DB_RLS_ENABLED=False

# Chat trace để xuất dataset RAGAS theo tháng (query/answer/context/chunk IDs).
# Tắt nếu không muốn lưu nội dung hội thoại; retention tính bằng ngày (tối đa 365).
CHAT_HISTORY_ENABLED=True
CHAT_HISTORY_RETENTION_DAYS=365
# Session memory ngắn gửi kèm prompt: tối đa N lượt gần nhất và trần token.
CHAT_HISTORY_CONTEXT_TURNS=3
CHAT_HISTORY_CONTEXT_TOKENS=500

# Database (PostgreSQL 16 Low-Memory)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="saas_knowledge_db"

# Docker Compose production: role ứng dụng riêng cho RLS.
# Init script scripts/init_db_app_role.sh tạo role này trên volume PostgreSQL mới.
APP_DB_USER="saas_app"
APP_DB_PASSWORD="change_me_app_db_password"

# Shared Google AI Studio API Key (dùng chung cho cả gemini-embedding-001 lẫn LLM)
GOOGLE_API_KEY="your_google_api_key_here"

# LLM Cloud Inference (Gemini 3.5 Flash Lite trên Google Gemini API)
LLM_PROVIDER="google"
LLM_API_URL="https://generativelanguage.googleapis.com"
LLM_MODEL="gemini-3.5-flash-lite"

# Embedding Inference API (gemini-embedding-001, 786 chiều, batch tối đa 10 chunks/call)
EMBEDDING_PROVIDER="google"
EMBEDDING_API_URL="https://generativelanguage.googleapis.com"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=786
EMBEDDING_BATCH_SIZE=10

# Storage
FAISS_INDEX_STORAGE_PATH="backend/storage/indexes"

# Container Registry (chỉ dùng cho deploy/registry — VPS pull image, không build)
# DOCKER_IMAGE_PREFIX: namespace trên registry.
#   Docker Hub public : neshaki091
#   GHCR private      : ghcr.io/neshaki091
# IMAGE_TAG: tag bất biến đang có trên registry. deploy_vps.sh TỪ CHỐI "latest".
#   CI/CD tự cập nhật dòng này khi deploy; deploy thủ công thì sửa tay.
DOCKER_IMAGE_PREFIX="neshaki091"
IMAGE_TAG="2.5.0"
